# Optional future server-side AI provider key. Never expose this in browser code.
AI_API_KEY=

# Optional visual generation adapter. API URL must accept an OpenAI-compatible
# POST body {prompt, response_format:"b64_json", output_format:"png"} and return
# {data:[{b64_json:"..."}]}. Keep all secrets on the server.
LIFE_QUEST_VISUAL_API_URL=
LIFE_QUEST_VISUAL_API_KEY=
# Required admin-only bearer token for POST /api/visuals/generate. Do not put in frontend code.
LIFE_QUEST_VISUAL_ADMIN_TOKEN=
